---
// Instant redirect to the first docs page (no 2s meta-refresh delay).
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0;url=/docs/getting-started" />
    <link rel="canonical" href="/docs/getting-started" />
    <meta name="robots" content="noindex" />
    <title>Redirecting…</title>
    <script>
      window.location.replace("/docs/getting-started");
    </script>
  </head>
  <body>
    <a href="/docs/getting-started">Continue to the documentation</a>
  </body>
</html>
