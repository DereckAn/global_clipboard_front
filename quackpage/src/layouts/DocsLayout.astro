---
import BaseLayout from "./BaseLayout.astro";
import Icon from "../components/Icon.astro";

interface Props {
  title: string;
  description?: string;
  /** rendered above content as the H1 */
  heading: string;
  /** one-line summary under the heading */
  summary: string;
}

const { title, description, heading, summary } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "");

const nav = [
  {
    group: "Get going",
    items: [
      { href: "/docs/getting-started", label: "Getting Started", icon: "bolt" },
      {
        href: "/docs/keyboard-shortcuts",
        label: "Keyboard Shortcuts",
        icon: "keyboard",
      },
    ],
  },
  {
    group: "Going further",
    items: [
      { href: "/docs/sync", label: "Sync", icon: "sync" },
      { href: "/docs/privacy", label: "Privacy & Data", icon: "lock" },
    ],
  },
];

// flatten for prev/next
const flat = nav.flatMap((g) => g.items);
const idx = flat.findIndex((i) => i.href === path);
const prev = idx > 0 ? flat[idx - 1] : null;
const next = idx >= 0 && idx < flat.length - 1 ? flat[idx + 1] : null;
---

<BaseLayout title={title} description={description}>
  <div class="shell grid gap-10 pt-12 pb-8 lg:grid-cols-[220px_1fr] lg:gap-14">
    <!-- sidebar -->
    <aside class="lg:sticky lg:top-24 lg:self-start">
      <p class="mb-5 font-mono text-xs uppercase tracking-widest text-accent">
        Documentation
      </p>
      <nav class="space-y-7" aria-label="Documentation">
        {
          nav.map((g) => (
            <div>
              <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-faint">
                {g.group}
              </p>
              <ul class="space-y-0.5">
                {g.items.map((item) => {
                  const active = item.href === path;
                  return (
                    <li>
                      <a
                        href={item.href}
                        aria-current={active ? "page" : undefined}
                        class={`flex items-center gap-2.5 rounded-md px-2.5 py-2 text-sm transition-colors ${
                          active
                            ? "bg-surface text-text"
                            : "text-muted hover:bg-surface/60 hover:text-text"
                        }`}
                      >
                        <Icon
                          name={item.icon}
                          size={16}
                          class={active ? "text-accent" : "text-faint"}
                        />
                        {item.label}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))
        }
      </nav>
    </aside>

    <!-- content -->
    <article class="min-w-0 max-w-2xl">
      <header class="border-b border-border-soft pb-7" data-reveal>
        <h1 class="text-4xl font-bold md:text-5xl">{heading}</h1>
        <p class="mt-4 text-lg text-muted">{summary}</p>
      </header>

      <div class="docs-prose mt-9" data-reveal>
        <slot />
      </div>

      <!-- prev / next -->
      <nav
        class="mt-16 grid gap-4 border-t border-border-soft pt-8 sm:grid-cols-2"
        aria-label="Pagination"
      >
        {
          prev ? (
            <a
              href={prev.href}
              class="lift rounded-lg border border-border bg-surface p-4"
            >
              <span class="text-xs text-faint">Previous</span>
              <span class="mt-1 flex items-center gap-2 font-medium">
                <Icon name="arrow-right" size={16} class="rotate-180 text-accent" />
                {prev.label}
              </span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a
              href={next.href}
              class="lift rounded-lg border border-border bg-surface p-4 text-right sm:col-start-2"
            >
              <span class="text-xs text-faint">Next</span>
              <span class="mt-1 flex items-center justify-end gap-2 font-medium">
                {next.label}
                <Icon name="arrow-right" size={16} class="text-accent" />
              </span>
            </a>
          )
        }
      </nav>
    </article>
  </div>
</BaseLayout>

<style is:global>
  /* Docs content typography — scoped to the prose container. */
  .docs-prose {
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.8;
  }
  .docs-prose > * + * {
    margin-top: 1.25rem;
  }
  .docs-prose h2 {
    color: var(--color-text);
    font-size: 1.6rem;
    margin-top: 3rem;
    padding-top: 0.5rem;
  }
  .docs-prose h3 {
    color: var(--color-text);
    font-size: 1.2rem;
    margin-top: 2rem;
  }
  .docs-prose strong {
    color: var(--color-text);
    font-weight: 600;
  }
  .docs-prose a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in oklab, var(--color-accent) 45%, transparent);
  }
  .docs-prose a:hover {
    text-decoration-color: var(--color-accent);
  }
  .docs-prose ul,
  .docs-prose ol {
    padding-left: 1.25rem;
  }
  .docs-prose ul {
    list-style: none;
  }
  .docs-prose ul > li {
    position: relative;
  }
  .docs-prose ul > li::before {
    content: "";
    position: absolute;
    left: -1rem;
    top: 0.75em;
    height: 5px;
    width: 5px;
    border-radius: 1px;
    background: var(--color-accent);
  }
  .docs-prose ol {
    list-style: decimal;
  }
  .docs-prose li + li {
    margin-top: 0.5rem;
  }
  .docs-prose li::marker {
    color: var(--color-faint);
  }
  .docs-prose code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border-soft);
    border-radius: 5px;
    padding: 0.1em 0.4em;
    color: var(--color-text);
  }
  .docs-prose pre {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--color-text);
  }
  .docs-prose pre code {
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
  }
</style>
